T IT DOES" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=10;fontColor=#55646f;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="640" y="10" width="81.60000000000001" height="16" as="geometry"/></mxCell><mxCell id="input-4" value="&lt;b&gt;what you typed&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8ebed;strokeColor=#72808a;fontColor=#17222b;horizontal=0;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="16" y="36" width="40" height="448" as="geometry"/></mxCell><mxCell id="input-5" value="1   /command, quit, help, how do i sound?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="36" width="490" height="34" as="geometry"/></mxCell><mxCell id="input-6" value="Run that command" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="36" width="340" height="34" as="geometry"/></mxCell><mxCell id="input-7" value="2   Starts with learn:" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="82" width="490" height="34" as="geometry"/></mxCell><mxCell id="input-8" value="Save as your own writing" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="82" width="340" height="34" as="geometry"/></mxCell><mxCell id="input-9" value="3   rewrite this for my boss: followed by text" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ec