<mxfile host="app.diagrams.net" agent="VoxMimic"><diagram id="system" name="Whole system"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="550" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="system-2" value="LEARNING: saves evidence, trains no model" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=10;fontColor=#55646f;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="30" y="42" width="278.8" height="16" as="geometry"/></mxCell><mxCell id="system-3" value="INFERENCE: turns pasted text into your voice" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=10;fontColor=#55646f;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="30" y="278" width="299.20000000000005" height="16" as="geometry"/></mxCell><mxCell id="system-4" value="&lt;b&gt;Your writing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;opening and daily answers&lt;br&gt;your edits, stated rules&lt;br&gt;writing you add&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="180" height="100" as="geometry"/></mxCell><mxCell id="system-5" value="&lt;b&gt;Learning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;drops duplicates, overlong&lt;br&gt;sentences; finds word swaps;&lt;br&gt;parses rules&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="180" height="100" as="geometry"/></mxCell><mxCell id="system-6" value="&lt;b&gt;profile.vox&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one SQLite file: samples,&lt;br&gt;corrections, rules, swaps&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ece6f4;strokeColor=#7a62a8;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="550" y="70" width="180" height="100" as="geometry"/></mxCell><mxCell id="system-7" value="&lt;b&gt;Voice profile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;rebuilt from samples: habits,&lt;br&gt;phrases, banned words&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="790" y="70" width="180" height="100" as="geometry"/></mxCell><mxCell id="system-8" value="&lt;b&gt;Pasted AI text&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;any length, many paragraphs;&lt;br&gt;code and headings kept as is&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8ebed;strokeColor=#72808a;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="180" height="100" as="geometry"/></mxCell><mxCell id="system-9" value="&lt;b&gt;Rewrite engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;finds examples of you, builds a prompt, writes up to 2 versions,&lt;br&gt;applies your habits, scores voice and facts, repairs once if needed&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="290" y="300" width="440" height="100" as="geometry"/></mxCell><mxCell id="system-10" value="&lt;b&gt;Text in your voice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;with voice and meaning scores,&lt;br&gt;and warnings if facts look off&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="790" y="300" width="180" height="100" as="geometry"/></mxCell><mxCell id="system-11" value="&lt;b&gt;Ollama, on your machine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gemma3:4b writes&lt;br&gt;nomic-embed-text compares&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbecc9;strokeColor=#b98512;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="290" y="440" width="210" height="70" as="geometry"/></mxCell><mxCell id="system-12" value="&lt;b&gt;Claude or OpenAI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;off unless you run&lt;br&gt;voxmimic model&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbecc9;strokeColor=#b98512;fontColor=#17222b;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="440" width="210" height="70" as="geometry"/></mxCell><mxCell id="system-13" value="sends" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="system-4" target="system-5"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0.0" y="-12.0" as="offset"/></mxGeometry></mxCell><mxCell id="system-14" value="saves" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=