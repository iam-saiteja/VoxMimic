eStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=0.6667;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3182;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="system-11" target="system-9"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="24.8" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="system-23" value="opt-in only" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;dashed=1;exitX=0.7614;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="system-9" target="system-12"><mxGeometry relative="1" x="0.0526" as="geometry"><mxPoint x="38.8" y="0.0" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="learning" name="Learning"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="580" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="learning-2" value="WHAT YOU GIVE IT" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=10;fontColor=#55646f;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="20" y="24" width="108.80000000000001" height="16" as="geometry"/></mxCell><mxCell id="learning-3" value="WHAT HAPPENS" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=10;fontColor=#55646f;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="270" y="24" width="81.60000000000001" height="16" as="geometry"/></mxCell><mxCell id="learning-4" value="TABLE IN PROFILE.VOX" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=10;fontColor=#55646f;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="540" y="24" width="136.0" height="16" as="geometry"/></mxCell><mxCell id="learning-5" value="WHAT A REWRITE READS" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=10;fontColor=#55646f;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="770" y="24" width="136.0" height="16" as="geometry"/></mxCell><mxCell id="learning-6" value="&lt;b&gt;Opening answers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;weight 1.0&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="190" height="50" as="geometry"/></mxCell><mxCell id="learning-7" value="&lt;b&gt;Daily answers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;weight 1.0&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="115" width="190" height="50" as="geometry"/></mxCell><mxCell id="learning-8" value="&lt;b&gt;Writing you add&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;weight 1.0; AI-looking skipped&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="190" height="50" as="geometry"/></mxCell><mxCell id="learning-9" value="&lt;b&gt;Your edit of a result&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;weight 2.0, the strongest signal&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="245" width="190" height="50" as="geometry"/></mxCell><mxCell id="learning-10" value="&lt;b&gt;A sentence you keep&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;daily &amp;quot;yes&amp;quot;, or &amp;quot;perfect&amp;quot;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="190" height="50" as="geometry"/></mxCell><mxCell id="learning-11" value="&lt;b&gt;A rule you state&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;never say &amp;quot;leverage&amp;quot;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="385" width="190" height="50" as="geometry"/></mxCell><mxCell id="learning-12" value="&lt;b&gt;Clean and dedupe&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;removes sentences over&lt;br&gt;50 words, ignores exact&lt;br&gt;repeats, tags the kind of&lt;br&gt;writing it came from&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="50" width="190" height="180" as="geometry"/></mxCell><mxCell id="learning-13" value="&lt;b&gt;Compare with the draft&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;word diff, edit similarity&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="245" width="190" height="50" as="geometry"/></mxCell><mxCell id="learning-14" value="&lt;b&gt;Parse the rule&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;unclear ones become notes&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="385" width="190" height="50" as="geometry"/></mxCell><mxCell id="learning-15" value="&lt;b&gt;samples&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;your writing&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ece6f4;strokeColor=#7a62a8;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="170" height="60" as="geometry"/></mxCell><mxCell id="learning-16" value="&lt;b&gt;swaps&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;quot;utilize&amp;quot; to &amp;quot;use&amp;quot;, with count&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ece6f4;strokeColor=#7a62a8;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="245" width="170" height="50" as="geometry"/></mxCell><mxCell id="learning-17" value="&lt;b&gt;corrections&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;before/after pairs&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ece6f4;strokeColor=#7a62a8;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="310" width="170" height="50" as="geometry"/></mxCell><mxCell id="learning-18" value="&lt;b&gt;rules&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;avoid, prefer, override, note&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ece6f4;strokeColor=#7a62a8;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="385" width="170" height="50" as="geometry"/></mxCell><mxCell id="learning-19" value="&lt;b&gt;Voice profile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;rebuilt on every load from&lt;br&gt;samples. Each one counts by:&lt;br&gt;words × kind × recency&lt;br&gt;(half-life 180 days, floor 25%)&lt;br&gt;&lt;br&gt;gives: sentence length, casing,&lt;br&gt;contractions, punctuation,&lt;br&gt;phrases, openers, banned words&lt;br&gt;rules override measurements&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="90" width="210" height="345" as="geometry"/></mxCell><mxCell id="learning-20" value="" style="endArrow=none;html=1;strokeColor=#4a7bb0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="782" y="300" as="sourcePoint"/><mxPoint x="968" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="learning-21" value="read as stored" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#17222b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="782" y="310" width="114.24000000000001" height="16" as="geometry"/></mxCell><mxCell id="learning-22" value="corrections: best examples" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11;fontColor=#17222b;" vertex="1" parent="1"><mxGeometry x="782" y="328" width="194.48000000000002" height="16" as="geometry"/></mxCell><mxCell id="learning-23" value="swaps: seen once goes in the" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11;fontColor=#17222b;" vertex="1" parent="1"><mxGeometry x="782" y="343" width="209.44000000000003" height="16" as="geometry"/></mxCell><mxCell id="learning-24" value="prompt, twice is auto-applied" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11;fontColor=#17222b;" vertex="1" parent="1"><mxGeometry x="782" y="358" width="216.92000000000002" height="16" as="geometry"/></mxCell><mxCell id="learning-25" value="rules: always followed" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11;fontColor=#17222b;" vertex="1" parent="1"><mxGeometry x="782" y="373" width="164.56" height="16" as="geometry"/></mxCell><mxCell id="learning-26" value="&lt;b&gt;During a rewrite&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;the model writes a stiff AI&lt;br&gt;version of your passage&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbecc9;strokeColor=#b98512;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="470" width="190" height="60" as="geometry"/></mxCell><mxCell id="learning-27" value="&lt;b&gt;neutrals, vectors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;caches, safe to rebuild&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ece6f4;strokeColor=#7a62a8;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="470" width="170" height="60" as="geometry"/></mxCell><mxCell id="learning-28" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.1389;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-6" target="learning-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="learning-29" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-7" target="learning-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="learning-30" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.8611;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-8" target="learning-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="learning-31" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-9" target="learning-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="learning-32" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-11" target="learning-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="learning-33" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.3333;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.3333;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-12" target="learning-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="learning-34" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-13" target="learning-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="learning-35" value="final text" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.2;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-13" target="learning-15"><mxGeometry relative="1" x="-0.0505" as="geometry"><mxPoint x="36.0" y="0.0" as="offset"/><Array as="points"><mxPoint x="495" y="255"/><mxPoint x="495" y="135"/></Array></mxGeometry></mxCell><mxCell id="learning-36" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.8;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-13" target="learning-17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="495" y="285"/><mxPoint x="495" y="325"/></Array></mxGeometry></mxCell><mxCell id="learning-37" value="pair only: the model&#x27;s sentence never counts as your writing" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-10" target="learning-17"><mxGeometry relative="1" x="0.1159" as="geometry"><mxPoint x="0.0" y="-12.0" as="offset"/></mxGeometry></mxCell><mxCell id="learning-38" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-14" target="learning-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="learning-39" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.087;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-15" target="learning-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="learning-40" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5217;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-16" target="learning-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="learning-41" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.7101;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-17" target="learning-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="learning-42" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.9275;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-18" target="learning-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="learning-43" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-26" target="learning-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="learning-44" value="reused next time" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="learning-27" target="learning-19"><mxGeometry relative="1" x="-0.2807" as="geometry"><mxPoint x="0.0" y="-12.0" as="offset"/><Array as="points"><mxPoint x="875" y="500"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="rewriting" name="Rewriting"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="580" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rewriting-2" value="&lt;b&gt;profile.vox and voice profile&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ece6f4;strokeColor=#7a62a8;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="16" width="430" height="42" as="geometry"/></mxCell><mxCell id="rewriting-3" value="&lt;b&gt;1  Pasted text&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;whatever you pasted,&lt;br&gt;or the daily stiff sentence&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8ebed;strokeColor=#72808a;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="190" height="84" as="geometry"/></mxCell><mxCell id="rewriting-4" value="&lt;b&gt;2  Split into blocks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;prose is rewritten; everything&lt;br&gt;else skips to step 11&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="90" width="190" height="84" as="geometry"/></mxCell><mxCell id="rewriting-5" value="&lt;b&gt;3  Prepare each chunk&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;110 words at most; removes&lt;br&gt;&amp;quot;it is important to note&amp;quot;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="90" width="190" height="84" as="geometry"/></mxCell><mxCell id="rewriting-6" value="&lt;b&gt;4  Pick examples&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;2 corrections, 3 near passages,&lt;br&gt;same kind of writing favoured&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="750" y="90" width="190" height="84" as="geometry"/></mxCell><mxCell id="rewriting-7" value="&lt;b&gt;5  Build the prompt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;measured habits, banned words,&lt;br&gt;rules, reader, then examples&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="750" y="234" width="190" height="84" as="geometry"/></mxCell><mxCell id="rewriting-8" value="&lt;b&gt;6  Model writes a version&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;a 2nd only if the 1st falls short;&lt;br&gt;the text is material, not orders&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbecc9;strokeColor=#b98512;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="234" width="190" height="84" as="geometry"/></mxCell><mxCell id="rewriting-9" value="&lt;b&gt;7  Filter replies&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;strips &amp;quot;here&amp;#x27;s your rewrite&amp;quot;;&lt;br&gt;drops replies about the task&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="234" width="190" height="84" as="geometry"/></mxCell><mxCell id="rewriting-10" value="&lt;b&gt;8  Apply your habits&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;casing, contractions, dashes,&lt;br&gt;swaps; puts digits back&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="234" width="190" height="84" as="geometry"/></mxCell><mxCell id="rewriting-11" value="&lt;b&gt;9  Score each version&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;voice, facts, overall meaning,&lt;br&gt;and each sentence for drops&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="190" height="84" as="geometry"/></mxCell><mxCell id="rewriting-12" value="&lt;b&gt;10  Keep the best&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;repairs lost facts, drift, copies,&lt;br&gt;dropped sentences, bad openers&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="400" width="190" height="84" as="geometry"/></mxCell><mxCell id="rewriting-13" value="&lt;b&gt;Report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;voice before and after, meaning,&lt;br&gt;any &amp;quot;Check this&amp;quot; warnings&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="400" width="190" height="84" as="geometry"/></mxCell><mxCell id="rewriting-14" value="&lt;b&gt;11  Your text&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;blocks rejoined in the&lt;br&gt;original order and shape&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="750" y="400" width="190" height="84" as="geometry"/></mxCell><mxCell id="rewriting-15" value="passages, corrections" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=0.7791;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rewriting-2" target="rewriting-6"><mxGeometry relative="1" x="0.2" as="geometry"><mxPoint x="-66.8" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="rewriting-16" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rewriting-3" target="rewriting-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rewriting-17" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rewriting-4" target="rewriting-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rewriting-18" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rewriting-5" target="rewriting-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rewriting-19" value="before/after pairs" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;