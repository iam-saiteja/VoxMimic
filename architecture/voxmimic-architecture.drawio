b98512;fontColor=#17222b;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="266" width="490" height="34" as="geometry"/></mxCell><mxCell id="input-16" value="Learn from your edit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="266" width="340" height="34" as="geometry"/></mxCell><mxCell id="input-17" value="7   20 words or fewer, like shorter or too formal" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbecc9;strokeColor=#b98512;fontColor=#17222b;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="312" width="490" height="34" as="geometry"/></mxCell><mxCell id="input-18" value="Change the last result" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="312" width="340" height="34" as="geometry"/></mxCell><mxCell id="input-19" value="8   perfect, love it, or the result pasted back as is" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbecc9;strokeColor=#b98512;fontColor=#17222b;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="358" width="490" height="34" as="geometry"/></mxCell><mxCell id="input-20" value="Keep as an example of you" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="358" width="340" height="34" as="geometry"/></mxCell><mxCell id="input-21" value="9   Two words or fewer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;