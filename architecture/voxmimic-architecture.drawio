y></mxCell><mxCell id="rewriting-24" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rewriting-11" target="rewriting-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rewriting-25" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rewriting-12" target="rewriting-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rewriting-26" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rewriting-13" target="rewriting-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rewriting-27" value="one repair, told what&#x27;s wrong" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=0.7368;exitY=0.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rewriting-12" target="rewriting-8"><mxGeometry relative="1" x="0.0109" as="geometry"><mxPoint x="0.0" y="-11.0" as="offset"/><Array as="points"><mxPoint x="410" y="359"/><mxPoint x="605" y="359"/></Array></mxGeometry></mxCell><mxCell id="rewriting-28" value="code, headings, tables and list markers pass through untouched" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=0.3158;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rewriting-4" target="rewriting-14"><mxGeometry relative="1" x="0.4096" as="geometry"><mxPoint x="0.0" y="-11.0" as="offset"/><Array as="points"><mxPoint x="330" y="204"/><mxPoint x="10" y="204"/><mxPoint x="10" y="530"/><mxPoint x="845" y="530"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="calls" name="Model calls"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="560" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="calls-2" value="" style="rounded=1;arcSize=2;html=1;fillColor=none;dashed=1;dashPattern=1 3;strokeColor=#55646f;" vertex="1" parent="1"><mxGeometry x="16" y="26" width="834" height="420" as="geometry"/></mxCell><mxCell id="calls-3" value="YOUR MACHINE: EVERY CALL GOES TO LOCALHOST:11434" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=10;fontColor=#55646f;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="28" y="32" width="326.40000000000003" height="16" as="geometry"/></mxCell><mxCell id="calls-4" value="&lt;b&gt;You paste text&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;once per chunk of up to 110 words&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="290" height="58" as="geometry"/></mxCell><mxCell id="calls-5" value="&lt;b&gt;A passage is used for the first time&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;your own writing, as an example&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="128" width="290" height="58" as="geometry"/></mxCell><mxCell id="calls-6" value="&lt;b&gt;shorter, too formal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&amp;quot;for my boss&amp;quot; is a full rewrite instead&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="290" height="58" as="geometry"/></mxCell><mxCell id="calls-7" value="&lt;b&gt;The daily sentence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;at most once a day, then saved&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="290" height="58" as="geometry"/></mxCell><mxCell id="calls-8" value="&lt;b&gt;gemma3:4b writes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;receives: your pasted text,&lt;br&gt;your habits and rules,&lt;br&gt;examples of your writing&lt;br&gt;&lt;br&gt;returns: a draft&lt;br&gt;&lt;br&gt;never trained, never changed,&lt;br&gt;keeps nothing between calls&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbecc9;strokeColor=#b98512;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="590" y="56" width="240" height="274" as="geometry"/></mxCell><mxCell id="calls-9" value="&lt;b&gt;Finding examples, checking meaning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;during all of the above&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="364" width="290" height="58" as="geometry"/></mxCell><mxCell id="calls-10" value="&lt;b&gt;nomic-embed-text compares&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;turns text into numbers only&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbecc9;strokeColor=#b98512;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="590" y="364" width="240" height="58" as="geometry"/></mxCell><mxCell id="calls-11" value="&lt;b&gt;Cloud model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;replaces gemma&lt;br&gt;only after you&lt;br&gt;run voxmimic&lt;br&gt;model&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbecc9;strokeColor=#b98512;fontColor=#17222b;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="870" y="150" width="120" height="110" as="geometry"/></mxCell><mxCell id="calls-12" value="&lt;b&gt;No model call at all&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;reading what you type, saving your answers, rules, word swaps, your voice profile,&lt;br&gt;voice and fact scoring, today&amp;#x27;s question, /me, /why, /forget&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="16" y="462" width="834" height="62" as="geometry"/></mxCell><mxCell id="calls-13" value="1 or 2 versions, plus 1 repair if needed" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.1058;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="calls-4" target="calls-8"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0.0" y="-12.0" as="offset"/></mxGeometry></mxCell><mxCell id="calls-14" value="1 stiff version, then cached" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.3686;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="calls-5" target="calls-8"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0.0" y="-12.0" as="offset"/></mxGeometry></mxCell><mxCell id="calls-15" value="2 versions" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.6314;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="calls-6" target="calls-8"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0.0" y="-12.0" as="offset"/></mxGeometry></mxCell><mxCell id="calls-16" value="one full rewrite" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.8942;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="calls-7" target="calls-8"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0.0" y="-12.0" as="offset"/></mxGeometry></mxCell><mxCell id="calls-17" value="embeddings, no writing" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="calls-9" target="calls-10"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0.0" y="-12.0" as="offset"/></mxGeometry></mxCell><mxCell id="calls-18" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeColor=#17222b;strokeWidth=1.3;fontSize=11;fontColor=#55646f;labelBackgroundColor=#ffffff;dashed=1;exitX=1.0;exitY=0.5438;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="calls-8" target="calls-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="daily" name="Daily loop"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="565" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="daily-2" value="&lt;b&gt;You open voxmimic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;checks whether today&amp;#x27;s&lt;br&gt;check-in is finished&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8ebed;strokeColor=#72808a;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="190" height="84" as="geometry"/></mxCell><mxCell id="daily-3" value="&lt;b&gt;Pick one question&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;least-seen kind of writing;&lt;br&gt;every 5th asks a preference&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="190" height="84" as="geometry"/></mxCell><mxCell id="daily-4" value="&lt;b&gt;You answer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one sentence is plenty;&lt;br&gt;Enter skips&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="60" width="190" height="84" as="geometry"/></mxCell><mxCell id="daily-5" value="&lt;b&gt;Rewrite a stiff sentence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;same kind of writing as the&lt;br&gt;question, in the full engine&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbecc9;strokeColor=#b98512;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="750" y="60" width="190" height="84" as="geometry"/></mxCell><mxCell id="daily-6" value="&lt;b&gt;Would you say this?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Enter keeps it&lt;br&gt;typing fixes it&lt;br&gt;skip passes&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d9f1e4;strokeColor=#2f8a5f;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="750" y="250" width="190" height="100" as="geometry"/></mxCell><mxCell id="daily-7" value="&lt;b&gt;Kept&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;example pair, similarity 100%&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3ecf6;strokeColor=#4a7bb0;fontColor=#17222b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="210" width="190" height="50" as="geometry"/></mxCell><mxCell id="daily-8" value="&lt;b&gt;Edited&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;fon